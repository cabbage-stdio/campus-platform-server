<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.RepairDeviceMapper">
    
    <resultMap type="RepairDevice" id="RepairDeviceResult">
        <result property="id"    column="id"    />
        <result property="deviceCode"    column="device_code"    />
        <result property="deviceName"    column="device_name"    />
        <result property="modelId"    column="model_id"    />
        <result property="areaId"    column="area_id"    />
        <result property="locationDetail"    column="location_detail"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRepairDeviceVo">
        select id, device_code, device_name, model_id, area_id, location_detail, status, remark, create_by, create_time, update_by, update_time from repair_device
    </sql>

    <select id="selectRepairDeviceList" parameterType="RepairDevice" resultMap="RepairDeviceResult">
        <include refid="selectRepairDeviceVo"/>
        <where>  
            <if test="deviceCode != null  and deviceCode != ''"> and device_code = #{deviceCode}</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="modelId != null "> and model_id = #{modelId}</if>
            <if test="areaId != null "> and area_id = #{areaId}</if>
            <if test="locationDetail != null  and locationDetail != ''"> and location_detail = #{locationDetail}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by area_id
    </select>
    
    <select id="selectRepairDeviceById" parameterType="Long" resultMap="RepairDeviceResult">
        <include refid="selectRepairDeviceVo"/>
        where id = #{id}
    </select>
    <select id="countDeviceByModelId" resultType="java.lang.Integer">
        select count(*) from repair_device where model_id = #{modelId}
    </select>
    <select id="countDeviceByAreaId" resultType="java.lang.Integer">
        select count(*) from repair_device where area_id = #{areaId}
    </select>

    <insert id="insertRepairDevice" parameterType="RepairDevice" useGeneratedKeys="true" keyProperty="id">
        insert into repair_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceName != null and deviceName != ''">device_name,</if>
            <if test="modelId != null">model_id,</if>
            <if test="areaId != null">area_id,</if>
            <if test="locationDetail != null and locationDetail != ''">location_detail,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceName != null and deviceName != ''">#{deviceName},</if>
            <if test="modelId != null">#{modelId},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="locationDetail != null and locationDetail != ''">#{locationDetail},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDeviceCode" parameterType="RepairDevice">
        update repair_device set device_code = #{deviceCode} where id = #{id}
    </update>

    <update id="updateRepairDevice" parameterType="RepairDevice">
        update repair_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceName != null and deviceName != ''">device_name = #{deviceName},</if>
            <if test="modelId != null">model_id = #{modelId},</if>
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="locationDetail != null and locationDetail != ''">location_detail = #{locationDetail},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRepairDeviceById" parameterType="Long">
        delete from repair_device where id = #{id}
    </delete>

    <delete id="deleteRepairDeviceByIds" parameterType="String">
        delete from repair_device where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
