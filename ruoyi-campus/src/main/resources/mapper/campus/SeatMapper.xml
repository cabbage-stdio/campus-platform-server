<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.SeatMapper">
    
    <resultMap type="Seat" id="SeatResult">
        <result property="id"    column="id"    />
        <result property="areaId"    column="area_id"    />
        <result property="floorNo"    column="floor_no"    />
        <result property="seatCode"    column="seat_code"    />
        <result property="locationDetail"    column="location_detail"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSeatVo">
        select id, area_id, floor_no, seat_code, location_detail, status, remark, create_by, create_time, update_by, update_time from seat
    </sql>

    <select id="selectSeatList" parameterType="Seat" resultMap="SeatResult">
        <include refid="selectSeatVo"/>
        <where>  
            <if test="areaId != null "> and area_id = #{areaId}</if>
            <if test="floorNo != null "> and floor_no = #{floorNo}</if>
            <if test="seatCode != null  and seatCode != ''"> and seat_code = #{seatCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectSeatById" parameterType="Long" resultMap="SeatResult">
        <include refid="selectSeatVo"/>
        where id = #{id}
    </select>

    <select id="selectSeatNoForUpdate" resultType="java.lang.Long">
        SELECT current_no
        FROM seat_code_sequence
        WHERE code_prefix = #{prefix}
            FOR UPDATE
    </select>

    <insert id="insertSeat" parameterType="Seat" useGeneratedKeys="true" keyProperty="id">
        insert into seat
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="areaId != null">area_id,</if>
            <if test="floorNo != null">floor_no,</if>
            <if test="seatCode != null">seat_code,</if>
            <if test="locationDetail != null">location_detail,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="areaId != null">#{areaId},</if>
            <if test="floorNo != null">#{floorNo},</if>
            <if test="seatCode != null">#{seatCode},</if>
            <if test="locationDetail != null">#{locationDetail},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>
    <insert id="increaseSeatNo">
        INSERT INTO seat_code_sequence (code_prefix, current_no)
        VALUES (#{prefix}, 1)
        ON DUPLICATE KEY UPDATE current_no = current_no + 1
    </insert>

    <update id="updateSeat" parameterType="Seat">
        update seat
        <trim prefix="SET" suffixOverrides=",">
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="floorNo != null">floor_no = #{floorNo},</if>
            <if test="seatCode != null">seat_code = #{seatCode},</if>
            <if test="locationDetail != null">location_detail = #{locationDetail},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSeatById" parameterType="Long">
        delete from seat where id = #{id}
    </delete>

    <delete id="deleteSeatByIds" parameterType="String">
        delete from seat where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>